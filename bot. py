@bot.message_handler(func=lambda m: True)
def create_presentation(message):
    chat_id = message.chat.id
    tariff_name, used, expiry_str, last_gen = get_user(chat_id)
    tariff = TARIFFS[tariff_name]

    # Проверка подписки
    if expiry_str:
        try:
            expiry_date = datetime.strptime(expiry_str, "%Y-%m-%d")
            if datetime.now() >= expiry_date:
                update_user(chat_id, tariff='free', presentations_used=0, expiry=None)
                tariff_name = 'free'
                tariff = TARIFFS['free']
                used = 0
        except:
            update_user(chat_id, tariff='free', presentations_used=0, expiry=None)
            tariff_name = 'free'
            tariff = TARIFFS['free']
            used = 0

    # Проверка лимита
    if used >= tariff['total_allowed']:
        if tariff_name == 'free':
            markup = telebot.types.InlineKeyboardMarkup()
            markup.add(telebot.types.InlineKeyboardButton("💳 Выбрать тариф", callback_data="show_tariffs"))
            bot.reply_to(message, "❌ Бесплатные презентации закончились.\nВыберите платный тариф!", reply_markup=markup)
        else:
            bot.reply_to(message, "❌ Лимит презентаций исчерпан.\nДождитесь нового месяца или купите другой тариф.")
        return

    # Проверка задержки
    if tariff['delay'] > 0:
        current_time = time.time()
        time_diff = current_time - last_gen
        if time_diff < tariff['delay']:
            wait_time = int(tariff['delay'] - time_diff)
            bot.reply_to(message, f"⏳ Подождите {wait_time} сек. перед следующей генерацией.\nЭто ограничение вашего тарифа «{tariff['name']}».")
            return

    # Парсим тему и стиль
    user_input = message.text.split(",")
    topic = user_input[0].strip()
    style = user_input[1].strip() if len(user_input) > 1 else "современный"

    # Сообщение о задержке
    delay_msg = ""
    if tariff['delay'] > 0:
        delay_msg = f"\n⏳ Ваш тариф «{tariff['name']}» — задержка {tariff['delay']} сек."

    # Генерация
    wait_est = 30 + tariff['delay']
    bot.reply_to(message, f"🎨 Генерирую: «{topic}» в стиле «{style}».{delay_msg}\nПримерное время: {wait_est} секунд.")

    update_user(chat_id, last_generation=time.time())

    # Генерируем текст
    try:
        json_str = generate_text(topic, style, tariff['max_slides'])
        json_str = json_str.strip().replace("```json", "").replace("```", "")
        data = json.loads(json_str)
    except:
        bot.reply_to(message, "❌ Ошибка генерации текста. Попробуйте ещё раз.")
        return

    # Создаём PowerPoint
    prs = Presentation()
    prs.slide_width = Inches(13.333)
    prs.slide_height = Inches(7.5)

    slides = data["slides"][:tariff['max_slides']]
    images_generated = 0

    for i, slide_data in enumerate(slides):
        slide = prs.slides.add_slide(prs.slide_layouts[6])

        if images_generated < tariff['max_images']:
            try:
                img_prompt = slide_data.get("image_prompt", f"{topic} {style} slide {i+1}")
                image_file = generate_image(img_prompt)
                if image_file:
                    slide.shapes.add_picture(image_file, Inches(0), Inches(0), prs.slide_width, prs.slide_height)
                    images_generated += 1
            except:
                pass

        txBox = slide.shapes.add_textbox(Inches(0.5), Inches(0.5), Inches(12.333), Inches(1))
        tf = txBox.text_frame
        tf.text = slide_data["title"]
        tf.paragraphs[0].font.size = Inches(0.5)
        tf.paragraphs[0].font.bold = True

        txBox2 = slide.shapes.add_textbox(Inches(0.5), Inches(1.8), Inches(12.333), Inches(5))
        tf2 = txBox2.text_frame
        tf2.text = slide_data["content"]
        tf2.paragraphs[0].font.size = Inches(0.35)

    update_user(chat_id, presentations_used=used + 1)

    filename = f"{topic[:30]}_{style}.pptx"
    prs.save(filename)

    with open(filename, "rb") as f:
        bot.send_document(chat_id, f)

    os.remove(filename)

    remaining = tariff['total_allowed'] - (used + 1)
    bot.send_message(chat_id, f"✅ Готово! {len(slides)} слайдов, {images_generated} картинок.\nОсталось презентаций: {remaining}")

