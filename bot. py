# ---------- БАЗА ДАННЫХ ----------
DB_FILE = "users.db"

def init_db():
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users (
        chat_id INTEGER PRIMARY KEY,
        tariff TEXT DEFAULT 'free',
        presentations_used INTEGER DEFAULT 0,
        subscription_expiry TEXT,
        last_generation REAL DEFAULT 0
    )''')
    conn.commit()
    conn.close()

def get_user(chat_id):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute("SELECT tariff, presentations_used, subscription_expiry, last_generation FROM users WHERE chat_id=?", (chat_id,))
    row = c.fetchone()
    conn.close()
    if row is None:
        conn = sqlite3.connect(DB_FILE)
        c = conn.cursor()
        c.execute("INSERT INTO users (chat_id, tariff, presentations_used) VALUES (?, 'free', 0)", (chat_id,))
        conn.commit()
        conn.close()
        return 'free', 0, None, 0
    return row[0], row[1], row[2], row[3]

def update_user(chat_id, tariff=None, presentations_used=None, expiry=None, last_generation=None):
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    if tariff is not None:
        c.execute("UPDATE users SET tariff=? WHERE chat_id=?", (tariff, chat_id))
    if presentations_used is not None:
        c.execute("UPDATE users SET presentations_used=? WHERE chat_id=?", (presentations_used, chat_id))
    if expiry is not None:
        c.execute("UPDATE users SET subscription_expiry=? WHERE chat_id=?", (expiry, chat_id))
    if last_generation is not None:
        c.execute("UPDATE users SET last_generation=? WHERE chat_id=?", (last_generation, chat_id))
    conn.commit()
    conn.close()

init_db()

# ---------- ГЕНЕРАЦИЯ ТЕКСТА (DeepSeek через ProxyAPI) ----------
def generate_text(topic, style, max_slides):
    prompt = f"""Придумай структуру презентации на тему: «{topic}» в стиле «{style}».
Выведи ответ строго в формате JSON:
{{
  "slides": [
    {{"title": "Заголовок слайда 1", "content": "Текст слайда 1 (2-3 предложения)", "image_prompt": "Описание картинки на английском"}},
    {{"title": "Заголовок слайда 2", "content": "Текст слайда 2", "image_prompt": "Описание картинки"}}
  ]
}}
Сделай ровно {max_slides} слайдов. Описания картинок — на английском, без текста в картинке."""

    response = requests.post(
        "https://api.proxyapi.ru/deepseek/chat/completions",
        headers={
            "Authorization": f"Bearer {PROXYAPI_KEY}",
            "Content-Type": "application/json"
        },
        json={
            "model": "deepseek-chat",
            "messages": [
                {"role": "system", "content": "Ты профессиональный создатель презентаций. Отвечай ТОЛЬКО валидным JSON."},
                {"role": "user", "content": prompt}
            ]
        }
    )
    return response.json()["choices"][0]["message"]["content"]

# ---------- ГЕНЕРАЦИЯ КАРТИНКИ (Flux через ProxyAPI) ----------
def generate_image(prompt):
    response = requests.post(
        "https://api.proxyapi.ru/flux/v1/images/generations",
        headers={
            "Authorization": f"Bearer {PROXYAPI_KEY}",
            "Content-Type": "application/json"
        },
        json={
            "model": "flux-schnell",
            "prompt": prompt,
            "n": 1,
            "size": "1024x768"
        }
    )
    data = response.json()
    if "data" in data and len(data["data"]) > 0:
        img_response = requests.get(data["data"][0]["url"])
        return BytesIO(img_response.content)
    return None

